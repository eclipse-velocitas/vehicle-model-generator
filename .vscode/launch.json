{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [],
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "gen-vehicle-model",
            "program": "${workspaceFolder}/src/velocitas/model_generator/cli.py",
            "console": "internalConsole",
            "args": [
                "--target-folder", "velocitas_model",
                "--package-name", "velocitas_model",
                "--language", "${input:languageId}",
                "--include-dir", "${input:includeDir}",
                "${input:inputFilePath}"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/"
                   }
        }
    ],
    "inputs": [
        {
            "type":"promptString",
            "id": "inputFilePath",
            "description": "Path to the main input file. Either .vspec or .json."
        },
        {
            "type": "promptString",
            "id": "includeDir",
            "description": "Included directories for a vspec tree."
        },
        {
            "type": "pickString",
            "id": "languageId",
            "description": "What type of component do you want to create?",
            "options": [
                "python",
                "cpp"
            ],
            "default": "python"
        }
    ]
}
